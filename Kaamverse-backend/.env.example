DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:8443

DB_NAME=kaamverse_db
DB_USER=kaamverse_app
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Google Workspace / Gmail SMTP. Use an app password, never the normal mailbox password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
DEFAULT_FROM_EMAIL=KaamVerse <your-account@example.com>
EMAIL_TIMEOUT=20

# Production security (enable only behind configured HTTPS)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
